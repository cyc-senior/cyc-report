{
  "baseUrl": "http://localhost:3000",
  "out": "figures/ch3-methodology/screens",
  "viewport": { "width": 1440, "height": 900, "scale": 2 },
  "beforeEach": "document.querySelectorAll('nextjs-portal').forEach(e => e.remove())",
  "vars": {
    "project": "af4a12e3-c445-4c81-abaa-5034d554f9e3",
    "story": "e5a717a2-117d-4ccf-8e02-4925f74a0033"
  },
  "shots": [
    {
      "name": "live-flow",
      "path": "/projects/{project}/stories/{story}/prompt",
      "final": false,
      "wait": 2000,
      "actions": [
        { "waitFor": "js:[...document.querySelectorAll('button')].some(b => b.innerText.includes('Approve & generate') && !b.disabled) && !document.querySelector('.animate-pulse')", "timeout": 60000 },
        { "wait": 3000 },
        { "snap": "prompt" },
        { "clickText": "Approve & generate", "after": 3000 },
        { "waitFor": "js:location.pathname.endsWith('/generate')", "timeout": 60000 },
        { "wait": 20000 },
        { "snap": "generate-trace-1" },
        { "wait": 90000 },
        { "snap": "generate-trace-2" },
        { "wait": 180000 },
        { "snap": "generate-trace-3" },
        { "waitFor": "js:location.pathname.endsWith('/refine')", "timeout": 2400000 },
        { "wait": 6000 },
        { "snap": "refine-new" }
      ]
    }
  ]
}
