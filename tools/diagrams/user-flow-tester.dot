// Tester and stakeholder user flow, redrawn from the Figma board "User flow (Hi-fi v2)".
// Render: dot -Tpdf tools/diagrams/user-flow-tester.dot -o figures/ch3-methodology/user-flow-tester.pdf
digraph UF {
  graph [rankdir=TB, nodesep=0.3, ranksep=0.25, fontname="TH Sarabun New", fontsize=20, newrank=true];
  node  [shape=box, style="rounded", fontname="TH Sarabun New", fontsize=17, margin="0.1,0.04", height=0.34, width=1.7];
  edge  [fontname="TH Sarabun New", fontsize=15, color="#555555", arrowsize=0.6];

  subgraph cluster_t { label="Usability Tester (ไม่ต้องมีบัญชี)"; style="rounded,dashed"; color="#999999";
    t5 [label="5B Add your details"]; t27 [label="27 Consent (PDPA)"]; t28 [label="28 Onboarding"];
    t29 [label="29 Task on Design 1 and 2"]; t30 [label="30 Chat feedback"]; t31 [label="31-32 Comments\n(ปักหมุดหรือทั้งหน้า)"];
    t33a [label="33A Preparing next round"]; d5 [label="แนวโน้มขึ้นลง?", shape=diamond, style="", width=1.6, margin="0.02,0.02"];
    t34 [label="34 Waiting for designer"]; t33 [label="33 What changed"];
    d6 [label="ครบรอบ?", shape=diamond, style="", width=1.3, margin="0.02,0.02"]; t35 [label="35 Finish and submit"]; t36 [label="36 Session complete"];
    t5 -> t27 -> t28 -> t29 -> t30 -> t31 -> t33a -> d5; d5 -> t33 [label=" ไม่"]; d5 -> t34 [label="ใช่"]; t34 -> t33;
    t33 -> d6; d6 -> t35 [label=" ครบ"]; t35 -> t36; d6 -> t29 [label="ยัง", constraint=false];
    {rank=same; d5; t34}
  }
  subgraph cluster_s { label="Client, Developer และ Project Manager"; style="rounded,dashed"; color="#999999";
    sR [label="R Reports"]; d7 [label="บทบาท?", shape=diamond, style="", width=1.3, margin="0.02,0.02"];
    s37 [label="37 Client report"]; s38 [label="38 Developer handoff"]; s39 [label="39 PM progress"];
    sR -> d7; d7 -> s37 [label="Client"]; d7 -> s38 [label="Developer"]; d7 -> s39 [label="PM"];
  }
  t36 -> sR [style=invis, weight=20];
}
