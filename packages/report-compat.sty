\ProvidesPackage{packages/report-compat}
\RequirePackage{etoolbox}
\RequirePackage{pgfgantt}
\RequirePackage{longtable}

\def\gtt@vgrid@do#1,{
  \ifx\relax#1\else
    \ifnum\gtt@currgrid>\gtt@chartwidth\else
      \gtt@vgrid@analyze#1\relax
    \fi
    \expandafter\gtt@vgrid@do
  \fi
}
\def\gtt@hgrid@do#1,{
  \ifx\relax#1\else
    \ifnum\gtt@currgrid<\gtt@currentline\else
      \gtt@hgrid@analyze#1\relax
    \fi
    \expandafter\gtt@hgrid@do
  \fi
}

%: Make longtable pages end with \vfil instead of \vss. Newer longtable releases
%: (e.g. TeX Live on CI) changed \LT@output, so the patch may not apply; then keep
%: longtable's own glue and only warn, rather than stopping the build.
\patchcmd{\LT@output}{\copy\LT@foot\vss}{\copy\LT@foot\vfil}{}
  {\PackageWarningNoLine{report-compat}{Cannot update longtable final-page glue; using longtable's default}}
\patchcmd{\LT@output}{\copy\LT@foot\vss}{\copy\LT@foot\vfil}{}
  {\PackageWarningNoLine{report-compat}{Cannot update longtable page glue; using longtable's default}}